{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],

  "ignorePaths": ["external-tests/**"],

  "labels": ["dependencies"],
  "minimumReleaseAge": "15 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "5 days"
  },

  "packageRules": [
    {
      "description": "Don't auto-upgrade LTS or legacy versions",
      "matchManagers": ["npm"],
      "matchDepTypes": [
        "pnpm.catalog.react16",
        "pnpm.catalog.react17",
        "pnpm.catalog.react18",
        "pnpm.catalog.react19",
        "pnpm.catalog.typescriptLTS"
      ],
      "enabled": false
    },
    {
      "description": "Group non-major dependencies/devDependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    }
  ]
}
